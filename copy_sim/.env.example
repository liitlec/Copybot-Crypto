# Lecture seule : AUCUNE clé privée n'est utilisée ni demandée.
# RPC Solana (Helius, Chainstack Solana, QuickNode...). Le RPC public est trop limité pour le backtest.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

CS_BANKROLL_SOL=1.0          # capital simulé de départ
CS_SIZE_MODE=fraction        # fraction (du capital courant, comme le post) | fixed
CS_SIZE=0.2                  # 20 % du capital par trade, ou X SOL si fixed
CS_MAX_OPEN=5                # positions simultanées max
CS_MAX_LEADER_BUY_SOL=0      # >0 : ignore les achats du leader plus gros que ça (0 = désactivé)
CS_LATENCY_S=2               # retard de copie supposé en backtest (le post annonce 0.5 s)
CS_SLIPPAGE_BPS=100          # slippage ajouté à chaque exécution (1 %)
CS_BOT_FEE_PCT=1.0           # commission du bot de copy trading par trade (%)
CS_TX_FEE_SOL=0.0005         # frais réseau + priority fee/Jito par transaction
CS_ROTATE_AFTER_LOSSES=2     # change de leader après N pertes d'affilée (0 = copie tous les leaders)
CS_POLL_S=3                  # mode live : intervalle de polling des wallets
JUP_QUOTE_URL=https://api.jup.ag/swap/v1/quote

# Classement automatique des leaders (copysim leaders). Clé gratuite sur solanatracker.io.
# Sans clé : repli sur GeckoTerminal (classement plus grossier).
SOLANATRACKER_API_KEY=
