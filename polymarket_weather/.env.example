# Copier en .env. Aucune clé n'est nécessaire pour le scanner météo (APIs publiques).
# Les clés wallet / Chainstack / OpenRouter ne sont PAS utilisées par ce module.

WX_DATA_DIR=data
WX_MODEL=ecmwf_ifs025            # ou ecmwf_ifs (HRES 9 km) si dispo sur Open-Meteo
WX_PROB_MODEL=normal             # normal | ensemble
WX_MIN_EDGE=0.08
WX_MAX_SPREAD=0.10               # on ignore les carnets plus larges que 10 cents
WX_MIN_LIQUIDITY=200
WX_FEE_RATE=0.01                 # frais taker supposés, en fraction du notionnel (hypothèse prudente)
WX_SLIPPAGE=0.01                 # cents ajoutés au best ask (profondeur inconnue)
WX_STAKE_USD=10
WX_MAX_TRADES_PER_EVENT=1
WX_PROB_CLIP=0.02                # jamais < 2 % ni > 98 %
WX_REQUIRE_STATION=1             # ignore les marchés dont la station n'est pas identifiée
WX_SCAN_INTERVAL_MIN=30
